<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Tranviko</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Tranviko</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Tranviko utilise le micro pour les appels, les messages vocaux et les contenus audio.</string>
	<key>NSCameraUsageDescription</key>
	<string>Tranviko utilise la camera pour les appels video, les stories, les QR codes et la verification des agents.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID peut etre utilise pour verrouiller et deverrouiller l'application.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Tranviko accede aux photos et videos que vous choisissez de partager.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Tranviko peut enregistrer dans votre phototheque les medias que vous choisissez de telecharger.</string>
	<key>NSContactsUsageDescription</key>
	<string>Tranviko accede a vos contacts avec votre accord pour retrouver et inviter vos proches.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Tranviko utilise les appareils audio Bluetooth pendant les appels.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>La position permet aux voyageurs et au gerant de suivre le bus.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Le suivi reste actif pendant la conduite lorsque l'application est en arriere-plan.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>location</string>
		<string>remote-notification</string>
		<string>voip</string>
	</array>
</dict>
</plist>
